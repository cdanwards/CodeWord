# Local env for Edge Functions. `supabase start` loads supabase/functions/.env (gitignored).
#
# Send pushes to the stand-in that scripts/push-check.mjs runs, instead of Expo. Remove this line
# to send real pushes from the local stack (needs an EAS project ID in the app and a real device).
EXPO_PUSH_URL=http://host.docker.internal:4599/push

# Only needed if "enhanced push security" is turned on for the Expo project.
# EXPO_ACCESS_TOKEN=
